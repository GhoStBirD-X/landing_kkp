{"nodes": [{"id": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "label": "Extraction Subagent Prompt", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_node_id_format", "label": "Node ID Format Rule", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs must be {full_repo_relative_stem}_{entity}, every directory level included, because this must match the ID the AST extractor generates independently; using only the filename or only the immediate parent directory creates orphan ghost-duplicate nodes when semantic and structural extraction disagree on naming."}, {"id": "claude_skills_graphify_references_extraction_spec_confidence_rubric", "label": "Confidence Score Rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INFERRED edges must pick one of five discrete values (0.95/0.85/0.75/0.65/0.55) instead of a continuous range, because production data showed models collapse a continuous range to a bimodal distribution (>50% at 0.5, >40% at 0.85+); a discrete rubric with named criteria is followed more faithfully."}, {"id": "claude_skills_graphify_references_extraction_spec_hyperedges_rule", "label": "Hyperedge Extraction Rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_semantic_similarity_rule", "lab